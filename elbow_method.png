


import seaborn as sns
import matplotlib.pyplot as plt
import pandas as pd
from sklearn.cluster import KMeans
import os
import kagglehub

# Download the dataset and get its path
path = kagglehub.dataset_download("shwetabh123/mall-customer")

# loading the data from csv file to a Pandas DataFrame using the correct path
customer_data = pd.read_csv(os.path.join(path, 'Mall_Customers.csv'))

X = customer_data.iloc[:,[3,4]].values

# finding wcss value for different number of clusters
wcss = []

for i in range(1,11):
  kmeans = KMeans(n_clusters=i, init='k-means++', random_state=42, n_init=10) # Added n_init parameter to avoid warning
  kmeans.fit(X)

  wcss.append(kmeans.inertia_)

# plot an elbow graph
sns.set()
plt.plot(range(1,11), wcss)
plt.title('The Elbow Point Graph')
plt.xlabel('Number of Clusters')
plt.ylabel('WCSS')
plt.show()


  
